{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://map2model.invalid/contracts/v1/JobStateV1.schema.json",
  "title": "JobStateV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "jobId",
    "correlationId",
    "phase",
    "status",
    "progress01",
    "reasonCode",
    "message",
    "details"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "kind": {
      "const": "JobStateV1"
    },
    "jobId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "correlationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "phase": {
      "enum": [
        "queued",
        "import",
        "decode",
        "mesh",
        "export",
        "verify",
        "complete",
        "cancel"
      ]
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "cancel_requested",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "progress01": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reasonCode": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "DATA_MISSING",
            "INVALID_REQUEST",
            "INVALID_SELECTION",
            "INVALID_CRS",
            "UNSUPPORTED_DATUM",
            "HASH_MISMATCH",
            "INVALID_SOURCE",
            "OUT_OF_MEMORY",
            "NON_MANIFOLD_MESH",
            "EXPORT_FAILED",
            "CANCELLED",
            "UNSUPPORTED_OPERATION",
            "INTERNAL_ERROR",
            "INCOMPLETE_GRID",
            "INVALID_GRID_HASH",
            "INVALID_GEOMETRY",
            "INVALID_DIMENSIONS",
            "NONFINITE_ELEVATION"
          ]
        }
      ]
    },
    "message": {
      "type": "string"
    },
    "details": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retryable",
        "missingTiles",
        "invalidSampleIndex",
        "invalidMeshElementIndex"
      ],
      "properties": {
        "retryable": {
          "type": "boolean"
        },
        "missingTiles": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "string",
            "maxLength": 160
          }
        },
        "invalidSampleIndex": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "invalidMeshElementIndex": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "succeeded"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "phase": {
            "const": "complete"
          },
          "reasonCode": {
            "type": "null"
          },
          "progress01": {
            "const": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "reasonCode": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "cancelled"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "reasonCode": {
            "const": "CANCELLED"
          },
          "phase": {
            "const": "cancel"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "cancel_requested"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "phase": {
            "enum": [
              "import",
              "decode",
              "mesh",
              "export",
              "verify",
              "cancel"
            ]
          }
        }
      }
    }
  ]
}
