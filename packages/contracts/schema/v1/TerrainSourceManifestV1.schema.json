{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://map2model.invalid/contracts/v1/TerrainSourceManifestV1.schema.json",
  "title": "TerrainSourceManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "sourceName",
    "releaseId",
    "archiveId",
    "localAssetToken",
    "sha256",
    "coverageBbox",
    "horizontalCrs",
    "verticalDatumId",
    "nativeGroundSampleMeters",
    "sourceBytes",
    "licenseIdentifier",
    "attribution",
    "decoderVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "kind": {
      "const": "TerrainSourceManifestV1"
    },
    "sourceName": {
      "type": "string",
      "minLength": 1
    },
    "releaseId": {
      "type": "string",
      "minLength": 1
    },
    "archiveId": {
      "type": "string",
      "minLength": 1
    },
    "localAssetToken": {
      "type": "string",
      "pattern": "^m2m-asset:[a-f0-9]{64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "coverageBbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      ],
      "items": false
    },
    "horizontalCrs": {
      "type": "string",
      "minLength": 1
    },
    "verticalDatumId": {
      "type": "string",
      "minLength": 1
    },
    "nativeGroundSampleMeters": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "sourceBytes": {
      "type": "integer",
      "minimum": 1
    },
    "licenseIdentifier": {
      "type": "string",
      "minLength": 1
    },
    "attribution": {
      "type": "string",
      "minLength": 1
    },
    "decoderVersion": {
      "type": "string",
      "minLength": 1
    }
  }
}
