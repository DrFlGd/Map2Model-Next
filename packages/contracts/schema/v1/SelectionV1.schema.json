{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://map2model.invalid/contracts/v1/SelectionV1.schema.json",
  "title": "SelectionV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "selectionId",
    "planet",
    "horizontalCrs",
    "bbox",
    "terrainProfile"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "kind": {
      "const": "SelectionV1"
    },
    "selectionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "planet": {
      "const": "earth"
    },
    "horizontalCrs": {
      "const": "EPSG:4326"
    },
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      ],
      "items": false
    },
    "terrainProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetGroundSampleMeters",
        "noDataPolicy",
        "maxSamples"
      ],
      "properties": {
        "targetGroundSampleMeters": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "noDataPolicy": {
          "const": "fail"
        },
        "maxSamples": {
          "type": "integer",
          "minimum": 4,
          "maximum": 50000000
        }
      }
    }
  }
}
